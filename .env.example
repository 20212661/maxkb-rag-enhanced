# Copy to .env, then run python3 deploy/configure.py to replace change-me with random local secrets.
COMPOSE_PROJECT_NAME=maxkb-rag
COMPOSE_PARALLEL_LIMIT=1
# Optional build dependency proxy. Registry pulls use the Docker daemon's proxy configuration.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=
MAXKB_IMAGE=maxkb-rag:local
MINERU_IMAGE=maxkb-rag-mineru:4.1.7
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm
REDIS_IMAGE=redis:7.4-bookworm
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8088
WEB_PUBLIC_URL=http://localhost:8088
WEB_API_URL=http://web:8080/admin/api
CHAT_API_URL=http://web:8080/chat/api
DB_NAME=maxkb
DB_USER=maxkb
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me
SECRET_KEY=change-me
# The initial account is admin. ADMIN_PASSWORD applies when the database is first created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
LOCAL_MODEL_HOST=local-model
LOCAL_MODEL_PORT=11636
LOCAL_MODEL_PROTOCOL=http
MINERU_CONTENT_LIST_URL=http://mineru-content:8004
MINERU_TASK_API_URL=http://mineru-api:8000
MINERU_FILE_PARSE_URL=http://mineru-file:8003
MINERU_MODEL_SOURCE=modelscope
MINERU_THREADS=4
MINERU_TIMEOUT_BASE_SECONDS=120
MINERU_TIMEOUT_PER_PAGE_SECONDS=30
EMBEDDING_CACHE_EPOCH=1
EMBEDDING_CACHE_ENABLED=true
QUERY_EMBEDDING_CACHE_ENABLED=true
QA_L1_CACHE_ENABLED=true
PROMPT_INCLUDE_DOCUMENT_NAME=true
# OpenAI-compatible answering endpoint. No real key belongs in this file.
LLM_API_BASE=
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_PROVIDER=model_openai_provider
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
DEMO_WORKSPACE_ID=default
DEMO_EMBEDDING_MODEL_ID=42f63a3d-427e-11ef-b3ec-a8a1595801ab
DEMO_WAIT_SECONDS=1800
# Optional GPU startup uses COMPOSE_FILE=compose.yaml:compose.gpu.yaml on Linux/WSL.
# COMPOSE_PROFILES=gpu
# MINERU_TASK_API_URL=http://mineru-api-gpu:8000
# MINERU_GPU_DEVICE_ID=0
